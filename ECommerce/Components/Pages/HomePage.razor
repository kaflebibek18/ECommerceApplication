@page "/"
@inject ECommerce.Services.IProductService ProductService
@inject ECommerce.Services.IStyleService StyleService
@inject NavigationManager Nav

<div class="cw-page">

    <!-- ==================== HEADER ==================== -->
    <header class="site-header">
        <div class="site-header-inner">
            <button class="site-hamburger" @onclick="ToggleMobileMenu" aria-label="Menu">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>

            <div class="site-header-left">
                <a href="/" class="site-logo">
                    <a href="https://www.instagram.com/comfywear____?igsh=MTF0aXk3dWJlMHkwNA==" target="_blank" rel="noopener noreferrer" class="site-insta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                        </svg>
                    </a>
                    <p style="color:white">comfy wear</p>
                </a>

                <nav class="site-nav @(_mobileMenuOpen ? "site-nav-open" : "")">
                    <a class="site-nav-link active" href="/" @onclick="@(() => _mobileMenuOpen = false)">Home</a>
                    <a class="site-nav-link" href="/items" @onclick="@(() => _mobileMenuOpen = false)">Shop</a>
                </nav>
            </div>

            <div class="site-header-right">
                <div class="site-search">
                    <svg class="site-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input type="text"
                           class="site-search-input"
                           placeholder="Search shoes..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                </div>
                <AuthStatus />
            </div>
        </div>
    </header>

