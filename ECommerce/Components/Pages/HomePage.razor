@code {
    private string SearchTerm = "";
    private bool _mobileMenuOpen = false;
    private List<ECommerce.Entities.Product> FeaturedProducts = new();

    private record CategoryTile(string Name, string Slug, string IconPath, int Count);
    private record TrustInfo(string SvgPath, string Label);

    private List<TrustInfo> TrustItems = new()
    {
        new("<path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/>", "Delivery all over Nepal"),
        new("<rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/>", "Cash on Delivery"),
        new("<path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/>", "Factory Direct"),
        new("<path d=\"M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/>", "Retail & Wholesale"),
    };

    private List<CategoryTile> Styles = new();

    protected override async Task OnInitializedAsync()
    {
        var allProducts = await ProductService.GetAllAsync();
        var allStyles = await StyleService.GetAllAsync();

        FeaturedProducts = allProducts.Where(p => p.StockQuantity > 0).Take(4).ToList();

        Styles = allStyles.Select(s => new CategoryTile(
            s.Name,
            s.Slug,
            s.Name.ToLower() switch
            {
                "flats" => "<path d=\"M6 32 Q6 20 18 18 L42 16 Q52 16 52 26 Q52 34 42 36 L14 38 Q6 38 6 32Z\"/><line x1=\"14\" y1=\"38\" x2=\"14\" y2=\"44\"/><line x1=\"38\" y1=\"36\" x2=\"38\" y2=\"44\"/>",
                "sandals" => "<path d=\"M8 30 Q8 18 20 16 L40 14 Q50 14 50 24 Q50 32 40 34 L12 36 Q8 36 8 30Z\"/><path d=\"M20 16 L24 8 M36 14 L34 6\"/><circle cx=\"24\" cy=\"8\" r=\"2\"/><circle cx=\"34\" cy=\"6\" r=\"2\"/>",
                "heels" => "<path d=\"M14 28 Q14 18 24 16 L40 15 Q48 15 48 22 Q48 30 40 31 L18 33 Q14 33 14 28Z\"/><path d=\"M18 33 L16 44 L22 44 L22 33\"/><line x1=\"16\" y1=\"44\" x2=\"22\" y2=\"44\"/>",
                "boots" => "<path d=\"M14 38 L14 14 Q14 8 20 8 L36 8 Q42 8 42 14 L42 38\"/><path d=\"M14 38 L8 38 L8 44 L46 44 L46 38 L42 38\"/><path d=\"M14 22 L42 22\"/><circle cx=\"14\" cy=\"14\" r=\"1.5\"/><circle cx=\"14\" cy=\"18\" r=\"1.5\"/>",
                "slippers" => "<path d=\"M10 32 Q10 22 22 20 L42 19 Q50 19 50 27 Q50 34 42 35 L14 36 Q10 36 10 32Z\"/><path d=\"M28 20 Q30 14 34 12\"/><circle cx=\"34\" cy=\"12\" r=\"1.5\"/>",
                _ => "<path d=\"M10 32 Q10 22 22 20 L42 19 Q50 19 50 27 Q50 34 42 35 L14 36 Q10 36 10 32Z\"/>"
            },
            allProducts.Count(p => p.StyleId == s.Id)
        )).ToList();
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private static bool IsNew(ECommerce.Entities.Product p)
    {
        return (DateTime.UtcNow - p.CreatedAt).TotalDays <= 14;
    }

    private void GoToCategory(string slug)
    {
        if (slug == "all")
            Nav.NavigateTo("/items");
        else
            Nav.NavigateTo($"/items?style={slug}");
    }
}
