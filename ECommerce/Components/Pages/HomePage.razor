    <!-- ==================== TRUST STRIP ==================== -->
    <div class="cw-trust-strip">
        <div class="cw-trust-inner">
            @foreach (var item in TrustItems)
            {
                <span class="cw-trust-item">
                    <svg class="cw-trust-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        @((MarkupString)item.SvgPath)
                    </svg>
                    @item.Label
                </span>
            }
        </div>
    </div>

    <!-- ==================== CATEGORIES ==================== -->
    <section class="cw-section">
        <div class="cw-section-header">
            <span class="cw-eyebrow">Browse</span>
            <h2 class="cw-section-title">Products by Style</h2>
            <div class="cw-rule"></div>
        </div>

        <div class="cw-category-grid">
            @foreach (var style in Styles)
            {
                <button type="button" class="cw-category-card" @onclick="@(() => GoToCategory(style.Slug))">
                    <div class="cw-category-icon">
                        <svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5">
                            @((MarkupString)style.IconPath)
                        </svg>
                    </div>
                    <span class="cw-category-name">@style.Name</span>
                    <span class="cw-category-count">@style.Count items</span>
                </button>
            }
        </div>
    </section>

    <!-- ==================== FEATURED PRODUCTS ==================== -->
