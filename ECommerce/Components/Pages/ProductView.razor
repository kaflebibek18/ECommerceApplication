@page "/sandals"
@using Radzen
@using Radzen.Blazor
@using ECommerce.ViewModel

<div class="sc-page">



    <div class="sc-hero">
        <div class="sc-eyebrow">Footwear / Leather Goods</div>
        <RadzenText TextStyle="TextStyle.DisplayH1" class="sc-title">
            Sandals<br />Collection
        </RadzenText>
        <p class="sc-sub">Full-grain leather, hand-stitched soles, built to break in — not break down.</p>
    </div>

    <div class="sc-grid">
        @foreach (var product in Products)
        {
            <RadzenCard class="sc-card">
                <div class="sc-card-media">
                    @if (!string.IsNullOrEmpty(product.Badge))
                    {
                        <RadzenBadge Text="@product.Badge"
                                     class="@("sc-badge" + (product.BadgeIsUrgent ? " sc-badge-low" : ""))" />
                    }
                    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg"
                         class="@(!product.InStock ? "sc-icon-muted" : "")">
                        <path d="@product.IconPath" fill="@product.AccentColor" opacity="0.85" />
                        <ellipse cx="60" cy="76" rx="38" ry="8" fill="#2B2420" opacity="0.15" />
                    </svg>
                </div>

                <div class="sc-card-body">
                    <RadzenText TextStyle="TextStyle.H6" class="sc-card-name">@product.Name</RadzenText>
                    <p class="sc-card-desc">@product.Description</p>

                    <div class="sc-tag">
                        <div class="sc-price">
                            Rs. @product.Price.ToString("N0")
                            <small>MRP incl. tax</small>
                        </div>
                        <div class="@("sc-stock " + (product.InStock ? "sc-stock-in" : "sc-stock-out"))">
                            <span class="sc-dot"></span>
                            @(product.InStock ? "In Stock" : "Out of Stock")
                        </div>
                    </div>

                    <RadzenButton Text="@(product.InStock ? "Add to Cart" : "Notify Me")"
                                  Disabled="@(!product.InStock)"
                                  Click="@(() => OnAddToCart(product))"
                                  class="sc-btn"
                                  ButtonStyle="ButtonStyle.Dark" />
                </div>
            </RadzenCard>
        }
    </div>

</div>

